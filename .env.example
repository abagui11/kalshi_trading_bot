# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Telegram (NEW bot only — do not reuse the spot bot token) ---
TELEGRAM_BOT_TOKEN=
PAYWALL_ENABLED=true
ALLOWED_TELEGRAM_IDS=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
MONITOR_CHAT_ID=
DASHBOARD_PUBLIC_URL=
DASHBOARD_PORT=8081

# --- Spot underlying (Coinbase public; used for direction context) ---
MARKET_DATA_API=https://api.coinbase.com/api/v3/brokerage/market

# --- Paper bankroll (house book; match real Kalshi cash for realism) ---
PORTFOLIO_VALUE=77
PAPER_PORTFOLIO_VALUE=77

# --- Kalshi (paper first; prod key OK if KALSHI_PAPER_ONLY=true) ---
# Paper soak: keep PAPER_ONLY=true. Live: set PAPER_ONLY=false (sizing uses bankroll).
KALSHI_ENV=prod
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_prod.key
KALSHI_SERIES=KXBTC15M,KXETH15M
KALSHI_PAPER_ONLY=true
# Contract safety ceiling; conviction deploy% is the real risk limiter.
KALSHI_MAX_CONTRACTS=100
KALSHI_MIN_EDGE_CENTS=8
KALSHI_CYCLE_OFFSET_SEC=30
# Bankroll + hard max risk per trade (never exceed 15% of book).
KALSHI_BANKROLL_USD=77
KALSHI_DEPLOY_PCT=0.05
KALSHI_MAX_DEPLOY_PCT=0.15
# 0 = disable absolute $ notional cap (deploy% governs).
KALSHI_MAX_NOTIONAL_USD=0
KALSHI_USE_LIVE_BALANCE=true
# Live IOC: paper filled at mid with no book; live must take. Cents of aggression on the bought side.
KALSHI_LIVE_TAKE_CENTS=2
KALSHI_LIVE_TIME_IN_FORCE=immediate_or_cancel

# Strategies: default control = always-on conviction product path.
# Experiments: ENABLED_BOTS=control,lottery,adverse
# Zero-Claude EVA product: ENABLED_BOTS=eva_wick (see EVA section below).
ENABLED_BOTS=control

# --- EVA wick bot (zero Anthropic tokens on this process) ---
# Bias comes from the hub's persisted H4/H1/M15 stances, not local Claude.
# INTELLIGENCE_API_URL=https://dashboard.eva.finance
# INTELLIGENCE_SERVICE_TOKEN=   # must match hub SERVICE_API_TOKENS
# Fail closed when the newest stance is older than this many minutes.
EVA_STANCE_MAX_AGE_MIN=90
# Flatten early when the bought side reaches entry × this multiple.
EVA_WICK_TP_MULTIPLE=2.0
# For a fully dark process, also disable the Claude side jobs:
# MACRO_CONTEXT_ENABLED=false   # macro RSS classify uses Claude
# WATCHDOG_ENABLED=false        # deterministic, but paper-fills as bot_id=control

# HTF/ICT Claude refresh: every_near_tick | once_per_window | ttl_event
# Paper-era default: every_near_tick (~2–3 Claude packs/product in the near band).
# once_per_window caps at 1 pack/product/15m window (cheaper, staler bias).
HTF_REFRESH_MODE=every_near_tick
HTF_BIAS_TTL_SEC=3600
HTF_M5_MOVE_PCT=0.20
HTF_REFRESH_ON_H1_CLOSE=true

# Macro news (RSS) — injects into vision + mid-block pulse/flatten
MACRO_FEED_URLS=https://www.federalreserve.gov/feeds/press_all.xml,https://www.cnbc.com/id/10000664/device/rss/rss.html,https://www.coindesk.com/arc/outboundfeeds/rss/
# MACRO_KEYWORD_EXTRA=optional,comma,keywords
